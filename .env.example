# Copy to ignored .env and fill every blank locally. Never commit real values.
# DATABASE_URL must match the POSTGRES_* values below; db is the service name.
DATABASE_URL=
ENVIRONMENT=development
FRONTEND_URL=
# Public browser API origin: never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=
BACKEND_HOST=
BACKEND_PORT=
FRONTEND_HOST=
FRONTEND_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
