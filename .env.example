# Copy to ignored .env and replace placeholders before running Docker Compose.
# DATABASE_URL must match the POSTGRES_* values below; db is the service name.
DATABASE_URL=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:<frontend-port>
# Public browser API origin: never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=http://localhost:<backend-port>
BACKEND_HOST=<backend-bind-host>
BACKEND_PORT=<backend-port>
FRONTEND_HOST=<frontend-bind-host>
FRONTEND_PORT=<frontend-port>
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=<postgres-port>
POSTGRES_BIND_HOST=<postgres-bind-host>
