# Copy to ignored .env and fill every blank setting before running Docker Compose.
# Runtime, migration, and sync database URLs use separate least-privilege roles.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SYNC_DATABASE_URL=
ENVIRONMENT=development
MLB_API_BASE_URL=
MLB_SPORT_ID=1
# Update at the season rollover; public endpoints cannot override this value.
MLB_CURRENT_SEASON=2026
MLB_REQUEST_TIMEOUT_SECONDS=10
MLB_MAX_CONCURRENT_REQUESTS=8
MLB_MAX_RESPONSE_BYTES=2000000
FRONTEND_URL=
# Public browser API origin: never put credentials in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=
# Server-only FastAPI origin, reachable from the Next.js process.
API_INTERNAL_URL=
BACKEND_HOST=
BACKEND_BIND_HOST=
BACKEND_PORT=
BACKEND_ALLOWED_HOSTS=
FRONTEND_HOST=
FRONTEND_BIND_HOST=
FRONTEND_PORT=
FRONTEND_ALLOWED_HOSTS=
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RATE_LIMIT_PER_MINUTE=120
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
POSTGRES_SYNC_USER=
POSTGRES_SYNC_PASSWORD=
POSTGRES_PORT=
