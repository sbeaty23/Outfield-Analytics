FRONTEND_HOST=<frontend-bind-host>
FRONTEND_PORT=<frontend-port>
POSTGRES_DB=outfield_analytics
POSTGRES_USER=outfield
POSTGRES_PASSWORD=outfield
POSTGRES_PORT=<postgres-port>
POSTGRES_BIND_HOST=<postgres-bind-host>
